<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的云备份与换机迁移规则。与 backup_rules.xml 保持同一套排除项：
     不外传 API Key、模型、录音与导出备份；只保留 Room 数据库里的练习记录。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ielts_prefs.xml" />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ielts_prefs.xml" />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
